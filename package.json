{
  "name": "newschat-extension",
  "version": "1.0.0",
  "type": "module",
  "description": "AI-powered news article Q&A Chrome extension",
  "license": "MIT",
  "engines": {
    "node": ">=22",
    "npm": ">=9"
  },
  "keywords": [
    "chrome-extension",
    "browser-extension",
    "news",
    "ai",
    "claude"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && vite build --mode background && vite build --mode content && node scripts/postbuild.js",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
